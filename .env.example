# ─────────────────────────────────────────────────────────────────────────────
# Template des variables d'environnement — AUCUNE vraie valeur ici.
#
# Usage : cp .env.example .env   puis remplir les valeurs.
# Le .env est gitignoré (il contient des credentials réels) ; les overrides
# personnels vont dans .env.local (gitignoré aussi). NE JAMAIS commiter l'un
# ou l'autre : le repo est PUBLIC.
#
# Ordre de chargement Symfony : .env → .env.local → .env.$APP_ENV → .env.$APP_ENV.local
# En prod (droplet), le .env vit sur le serveur (chmod 600) — voir docs/PRODUCTION.md.
# ─────────────────────────────────────────────────────────────────────────────

###> symfony/framework-bundle ###
APP_ENV=dev
# Générer avec : php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# PostgreSQL local (docker compose up -d fournit une instance de dev)
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/trading_data?serverVersion=15&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> cloudflare r2 — stockage des screenshots (voir docs/ARCHITECTURE.md) ###
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL publique de lecture des images (domaine r2.dev ou domaine custom)
SCREENSHOTS_BASE_URL=
###< cloudflare r2 ###

###> sentry/sentry-symfony ###
# Monitoring d'erreurs (actif en prod uniquement). Vide = désactivé.
# DSN du projet : sentry.io → Settings → Projects → Client Keys (DSN)
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> firebase authentication ###
# Configuration CLIENT : publique par nature (visible dans le JS de toute
# application Firebase), ce ne sont pas des secrets.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Configuration SERVEUR : véritable secret. Accepte au choix le chemin d'un
# fichier de service account hors dépôt, ou son contenu JSON encodé en base64
# (hébergeurs au FS éphémère). Laisser vide pour désactiver le login Google.
FIREBASE_CREDENTIALS=
###< firebase authentication ###
