{% if is_granted('ROLE_USER') and not app.user.isAdmin %}
<style>
    #chat-widget {
        position: fixed;
        bottom: 0;
        right: 1rem;
        z-index: 1050;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .chat-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1.1rem;
        border: none;
        border-radius: 10px 10px 0 0;
        background: var(--primary);
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 -2px 12px rgba(0,0,0,0.15);
    }

    .chat-bar:hover { background: var(--primary-2); }

    .chat-unread-badge {
        min-width: 1.25rem;
        height: 1.25rem;
        padding: 0 0.3rem;
        border-radius: 999px;
        background: #ef4444;
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .chat-window {
        width: 320px;
        height: 420px;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid var(--border);
        border-bottom: none;
        border-radius: 10px 10px 0 0;
        box-shadow: 0 -4px 24px rgba(0,0,0,0.18);
        overflow: hidden;
    }

    .chat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 0.9rem;
        background: var(--primary);
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .chat-minimize {
        border: none;
        background: none;
        color: #fff;
        font-size: 1.3rem;
        line-height: 1;
        cursor: pointer;
        padding: 0 0.3rem;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        background: #f8fafc;
    }

    .chat-msg { max-width: 85%; }
    .chat-msg.from-user { align-self: flex-end; text-align: right; }
    .chat-msg.from-admin { align-self: flex-start; }

    .chat-msg .chat-author {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 0.1rem;
    }

    .chat-bubble {
        display: inline-block;
        padding: 0.45rem 0.7rem;
        border-radius: 12px;
        font-size: 0.85rem;
        text-align: left;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .chat-msg.from-user .chat-bubble {
        background: var(--primary);
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .chat-msg.from-admin .chat-bubble {
        background: #fff;
        border: 1px solid var(--border);
        color: var(--text-main);
        border-bottom-left-radius: 4px;
    }

    .chat-time {
        font-size: 0.68rem;
        color: var(--text-muted);
        margin-top: 0.15rem;
    }

    .chat-error {
        font-size: 0.78rem;
        color: #dc2626;
        padding: 0 0.9rem 0.3rem;
    }

    .chat-input-zone {
        display: flex;
        align-items: flex-end;
        gap: 0.5rem;
        padding: 0.6rem 0.75rem;
        border-top: 1px solid var(--border);
        background: #fff;
        flex-shrink: 0;
    }

    .chat-input-zone textarea {
        flex: 1;
        resize: none;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.4rem 0.6rem;
        font-size: 0.85rem;
        max-height: 90px;
        line-height: 1.4;
    }

    .chat-input-zone textarea:focus {
        outline: none;
        border-color: var(--primary);
    }

    .chat-send {
        border: none;
        background: var(--primary);
        color: #fff;
        border-radius: 8px;
        width: 2.2rem;
        height: 2.2rem;
        cursor: pointer;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .chat-send:hover { background: var(--primary-2); }

    @media (max-width: 640px) {
        #chat-widget:has(.chat-window:not(.d-none)) {
            right: 0;
            left: 0;
        }

        .chat-window {
            width: 100%;
            height: calc(100dvh - 65px);
            border-radius: 0;
        }
    }
</style>

<div id="chat-widget"
     data-turbo-permanent
     data-controller="chat"
     data-chat-url-value="{{ path('app_chat_messages') }}">

    <button type="button" class="chat-bar" data-chat-target="bar" data-action="chat#open">
        💬 Contact
        <span class="chat-unread-badge d-none" data-chat-target="badge"></span>
    </button>

    <div class="chat-window d-none" data-chat-target="window">
        <div class="chat-header">
            <span>Support</span>
            <button type="button" class="chat-minimize" data-action="chat#close" aria-label="Réduire">&minus;</button>
        </div>

        <div class="chat-messages" data-chat-target="messages"></div>

        <template data-chat-target="welcome">
            <div class="chat-msg from-admin">
                <div class="chat-author">Support</div>
                <div class="chat-bubble">Merci d'utiliser Trading Tracker ! 🙏
Si tu as besoin d'aide, n'hésite pas à m'écrire ici, je te répondrai dès que possible.
Et si tu as des idées d'amélioration pour le site, je suis preneur !</div>
            </div>
        </template>

        <div class="chat-error d-none" data-chat-target="error"></div>

        <form class="chat-input-zone" data-action="submit->chat#send">
            <textarea data-chat-target="input"
                      data-action="keydown->chat#keydown input->chat#autogrow"
                      rows="1"
                      maxlength="2000"
                      placeholder="Écris ton message…"></textarea>
            <button type="submit" class="chat-send" aria-label="Envoyer">
                <i class="bi bi-send-fill"></i>
            </button>
        </form>
    </div>
</div>
{% endif %}
