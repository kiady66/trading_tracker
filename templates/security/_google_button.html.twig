{# Bouton de connexion Google. Le contrôleur Stimulus est déclaré « lazy » :
   le SDK Firebase (plusieurs centaines de Ko) n'est chargé que sur les pages
   qui incluent ce fragment. #}
<div data-controller="firebase-auth"
     data-firebase-auth-api-key-value="{{ firebase_api_key }}"
     data-firebase-auth-auth-domain-value="{{ firebase_auth_domain }}"
     data-firebase-auth-project-id-value="{{ firebase_project_id }}"
     data-firebase-auth-endpoint-value="{{ path('app_auth_firebase') }}">

    <div class="alert alert-danger d-none" data-firebase-auth-target="error" role="alert"></div>

    <button type="button"
            class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2"
            data-firebase-auth-target="button"
            data-action="firebase-auth#signIn">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
            <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
            <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/>
            <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
        </svg>
        <span>Continuer avec Google</span>
    </button>
</div>

<div class="d-flex align-items-center my-3 text-muted">
    <hr class="flex-grow-1">
    <span class="px-2 small">ou</span>
    <hr class="flex-grow-1">
</div>
