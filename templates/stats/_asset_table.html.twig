{# Performance par actif (carte pliable). Vars : asset_stats, unit ('eur'|'rr') #}
{% if asset_stats|length > 0 %}
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center"
                     role="button"
                     data-bs-toggle="collapse"
                     data-bs-target="#assetStatsCollapse"
                     aria-expanded="false"
                     aria-controls="assetStatsCollapse">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-currency-exchange"></i> Performance par actif
                    </h5>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <div id="assetStatsCollapse" class="collapse">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                <tr>
                                    <th>Actif</th>
                                    <th>Nombre de trades</th>
                                    <th>Taux de réussite</th>
                                    {% if unit == 'eur' %}
                                        <th>Gain total (€)</th>
                                        <th>Gain moyen (€)</th>
                                    {% endif %}
                                    <th>Gain total (R)</th>
                                    <th>Gain moyen (R)</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for asset, stats in asset_stats %}
                                    <tr>
                                        <td class="fw-bold">{{ asset }}</td>
                                        <td>{{ stats.total_trades }}</td>
                                        <td>
                                            <span class="badge bg-{{ stats.win_rate >= 50 ? 'success' : 'warning' }}">
                                                {{ stats.win_rate|number_format(1) }}%
                                            </span>
                                        </td>
                                        {% if unit == 'eur' %}
                                            <td class="{{ stats.total_gain_euro >= 0 ? 'text-success' : 'text-danger' }}">
                                                {{ stats.total_gain_euro|number_format(2) }} €
                                            </td>
                                            <td class="{{ stats.avg_gain_euro >= 0 ? 'text-success' : 'text-danger' }}">
                                                {{ stats.avg_gain_euro|number_format(2) }} €
                                            </td>
                                        {% endif %}
                                        <td class="{{ stats.total_gain_rr >= 0 ? 'text-success' : 'text-danger' }}">
                                            {{ stats.total_gain_rr|number_format(2) }} R
                                        </td>
                                        <td class="{{ stats.avg_gain_rr >= 0 ? 'text-success' : 'text-danger' }}">
                                            {{ stats.avg_gain_rr|number_format(2) }} R
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}
