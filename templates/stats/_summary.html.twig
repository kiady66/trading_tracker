{# Cartes de résumé. Vars : stats, unit ('eur'|'rr'), unit_label #}
<div class="d-flex flex-wrap gap-3 mb-4">
    <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
        <div class="card-body text-center d-flex flex-column justify-content-center">
            <h6 class="text-muted">Win Rate</h6>
            <div class="stats-number text-{{ stats.win_rate >= 50 ? 'success' : 'danger' }}">
                {{ stats.win_rate|default(0)|number_format(1) }}%
            </div>
            <small class="text-muted">{{ stats.winning_trades }}W / {{ stats.losing_trades }}L</small>
        </div>
    </div>

    <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
        <div class="card-body text-center d-flex flex-column justify-content-center">
            <h6 class="text-muted">Gain total</h6>
            {% if unit == 'eur' %}
                <div class="d-flex justify-content-between align-items-center blurrable" id="totalGainEuro">
                    <div style="flex: 1"></div>
                    <div style="flex: 10" class="stats-number text-{{ stats.total_gain >= 0 ? 'success' : 'danger' }}">
                        {{ stats.total_gain|default(0)|number_format(2) }} €
                    </div>
                    <i class="fas fa-eye clickable" onclick="toggleBlur('totalGainEuro')"
                       style="cursor: pointer; font-size: 1.2rem; flex: 1"></i>
                </div>
                <p class="card-text text-muted mb-0">
                    Gain total R: {{ stats.total_gain_rr|number_format(2) }} R
                </p>
            {% else %}
                <div class="stats-number text-{{ stats.total_gain >= 0 ? 'success' : 'danger' }}">
                    {{ stats.total_gain|default(0)|number_format(2) }} R
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
        <div class="card-body text-center d-flex flex-column justify-content-center">
            <h6 class="text-muted">Gain RR Moyen</h6>
            <div class="stats-number text-{{ stats.avg_gain_rr >= 0 ? 'success' : 'danger' }}">
                {{ stats.avg_gain_rr|default(0)|number_format(2) }}
            </div>
        </div>
    </div>

    <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
        <div class="card-body text-center d-flex flex-column justify-content-center">
            <h6 class="text-muted">Total Trades</h6>
            <div class="stats-number text-primary">
                {{ stats.total_trades }}
            </div>
        </div>
    </div>

    <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
        <div class="card-body text-center d-flex flex-column justify-content-center">
            <h6 class="text-muted">Profit Factor</h6>
            {% if stats.profit_factor is not null %}
                <div class="stats-number text-{{ stats.profit_factor >= 1 ? 'success' : 'danger' }}">
                    {{ stats.profit_factor|number_format(2) }}
                </div>
            {% else %}
                <div class="stats-number text-{{ stats.gross_profit > 0 ? 'success' : 'muted' }}">
                    {{ stats.gross_profit > 0 ? '∞' : '—' }}
                </div>
            {% endif %}
            <small class="text-muted">Gains bruts / Pertes brutes</small>
        </div>
    </div>

    <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
        <div class="card-body text-center d-flex flex-column justify-content-center">
            <h6 class="text-muted">Max Drawdown</h6>
            {% if unit == 'eur' %}
                <div class="d-flex justify-content-between align-items-center blurrable" id="maxDrawdownEuro">
                    <div style="flex: 1"></div>
                    <div style="flex: 10" class="stats-number text-danger">
                        -{{ stats.max_drawdown|default(0)|number_format(2) }} €
                    </div>
                    <i class="fas fa-eye clickable" onclick="toggleBlur('maxDrawdownEuro')"
                       style="cursor: pointer; font-size: 1.2rem; flex: 1"></i>
                </div>
                <p class="card-text text-muted mb-0">
                    Max Drawdown R: -{{ stats.max_drawdown_rr|number_format(2) }} R
                </p>
            {% else %}
                <div class="stats-number text-danger">
                    -{{ stats.max_drawdown|default(0)|number_format(2) }} R
                </div>
            {% endif %}
        </div>
    </div>
</div>
