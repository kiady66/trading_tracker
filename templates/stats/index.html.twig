{% extends 'base.html.twig' %}

{% block title %}Statistiques - Trading Tracker{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'stats/_head_assets.html.twig' %}
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    <i class="bi bi-bar-chart text-primary"></i> Statistiques
                </h1>
                <div class="btn-group" role="group" aria-label="Unité d'affichage">
                    <a href="{{ path('app_stats', app.request.query.all|merge({unit: 'eur'})) }}"
                       class="btn btn-sm btn-{{ unit == 'eur' ? 'primary' : 'outline-primary' }}">€</a>
                    <a href="{{ path('app_stats', app.request.query.all|merge({unit: 'rr'})) }}"
                       class="btn btn-sm btn-{{ unit == 'rr' ? 'primary' : 'outline-primary' }}">R</a>
                </div>
            </div>

            {% include 'stats/_filters.html.twig' with {extra_params: {unit: unit}} %}

            {% include 'stats/_summary.html.twig' %}

            {% include 'stats/_charts.html.twig' %}

            {% include 'stats/_calendar.html.twig' %}

            {% include 'stats/_detailed_table.html.twig' %}

            {% include 'stats/_confluence_table.html.twig' %}

            {% include 'stats/_day_table.html.twig' %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'stats/_charts_js.html.twig' %}
{% endblock %}
