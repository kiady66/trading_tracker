{% extends 'base.html.twig' %}

{% block title %}Statistiques - Trading Tracker{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    <!-- jQuery + Select2 -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/fr.js"></script>
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <style>
        .select2-container--bootstrap-5 .select2-selection--multiple {
            min-height: 38px;
        }
        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__rendered {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }
        .blurrable {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .blurrable.blurred {
            filter: blur(11px);
            user-select: none;
        }

        .calendar-table {
            table-layout: fixed;
            font-size: 0.8rem;
        }
        .calendar-table th {
            text-align: center;
        }
        .calendar-table td {
            height: 62px;
            padding: 4px;
            text-align: center;
            vertical-align: top;
            line-height: 1.2;
        }
        .calendar-day-num {
            font-size: 0.7rem;
            color: #6c757d;
            text-align: left;
        }
        .calendar-empty {
            background-color: var(--bs-tertiary-bg, #f8f9fa);
        }
        .calendar-week-total {
            vertical-align: middle !important;
            background-color: var(--bs-tertiary-bg, #f8f9fa);
        }
    </style>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    <i class="bi bi-bar-chart text-primary"></i> Statistiques
                </h1>
            </div>

            <!-- Filtres -->
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-funnel"></i> Filtres
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Date de début</label>
                            <input type="date" name="start_date" class="form-control"
                                   value="{{ filters.start_date }}">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Date de fin</label>
                            <input type="date" name="end_date" class="form-control"
                                   value="{{ filters.end_date }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Confluences</label>
                            <select name="confluences[]" multiple>
                                {% for confluence in all_confluences %}
                                    <option value="{{ confluence.id }}"
                                            {% if confluence.id in filters.confluences|default([]) %}selected{% endif %}>
                                        {{ confluence.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-filter"></i> Appliquer
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Stats Summary -->
            <div class="d-flex flex-wrap gap-3 mb-4"> <!-- Supprimer la height fixe -->
                <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h6 class="text-muted">Win Rate</h6>
                        <div class="stats-number text-{{ stats.win_rate >= 50 ? 'success' : 'danger' }}">
                            {{ stats.win_rate|default(0)|number_format(1) }}%
                        </div>
                        <small class="text-muted">{{ stats.winning_trades }}W / {{ stats.losing_trades }}L</small>
                    </div>
                </div>

                <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h6 class="text-muted">Gain total</h6>
                        <div class="d-flex justify-content-between align-items-center blurrable" id="totalGainEuro">
                            <div style="flex: 1"></div>
                            <div style="flex: 10" class="stats-number text-{{ stats.total_gain_euro >= 0 ? 'success' : 'danger' }}">
                                {{ stats.total_gain_euro|default(0)|number_format(2) }} €
                            </div>
                            <i class="fas fa-eye clickable" onclick="toggleBlur('totalGainEuro')"
                               style="cursor: pointer; font-size: 1.2rem; flex: 1"></i>
                        </div>
                        <p class="card-text text-muted mb-0">
                            Gain total R: {{ stats.total_gain_rr|number_format(2) }} R
                        </p>
                    </div>
                </div>

                <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h6 class="text-muted">Gain RR Moyen</h6>
                        <div class="stats-number text-{{ stats.avg_gain_rr >= 0 ? 'success' : 'danger' }}">
                            {{ stats.avg_gain_rr|default(0)|number_format(2) }}
                        </div>
                    </div>
                </div>

                <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h6 class="text-muted">Total Trades</h6>
                        <div class="stats-number text-primary">
                            {{ stats.total_trades }}
                        </div>
                    </div>
                </div>

                <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h6 class="text-muted">Profit Factor</h6>
                        {% if stats.profit_factor is not null %}
                            <div class="stats-number text-{{ stats.profit_factor >= 1 ? 'success' : 'danger' }}">
                                {{ stats.profit_factor|number_format(2) }}
                            </div>
                        {% else %}
                            <div class="stats-number text-{{ stats.gross_profit > 0 ? 'success' : 'muted' }}">
                                {{ stats.gross_profit > 0 ? '∞' : '—' }}
                            </div>
                        {% endif %}
                        <small class="text-muted">Gains bruts / Pertes brutes</small>
                    </div>
                </div>

                <div class="card stats-card flex-fill" style="min-width: 200px; max-width: calc(25% - 12px);">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h6 class="text-muted">Max Drawdown</h6>
                        <div class="d-flex justify-content-between align-items-center blurrable" id="maxDrawdownEuro">
                            <div style="flex: 1"></div>
                            <div style="flex: 10" class="stats-number text-danger">
                                -{{ stats.max_drawdown_euro|default(0)|number_format(2) }} €
                            </div>
                            <i class="fas fa-eye clickable" onclick="toggleBlur('maxDrawdownEuro')"
                               style="cursor: pointer; font-size: 1.2rem; flex: 1"></i>
                        </div>
                        <p class="card-text text-muted mb-0">
                            Max Drawdown R: -{{ stats.max_drawdown_rr|number_format(2) }} R
                        </p>
                    </div>
                </div>
            </div>
            <!-- Graphiques -->
            <div class="row mb-4">
                <!-- Gains Line Chart -->
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="bi bi-graph-up"></i> Évolution des Gains (€)
                        </div>
                        <div class="card-body">
                            <canvas id="gainsChart" height="250"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Gains RR Bar Chart -->
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="bi bi-bar-chart"></i> Gains RR par Trade
                        </div>
                        <div class="card-body">
                            <canvas id="gainRRChart" height="250"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <!-- Final RR Bar Chart -->
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="bi bi-bar-chart"></i> Final RR par Trade
                        </div>
                        <div class="card-body">
                            <canvas id="finalRRChart" height="250"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Win Rate Pie Chart -->
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="bi bi-pie-chart"></i> Win Rate
                        </div>
                        <div class="card-body">
                            <canvas id="winRateChart" height="250"></canvas>
                        </div>
                    </div>
                </div>


            </div>

            <!-- Drawdown Chart -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="bi bi-graph-down"></i> Drawdown (€)
                        </div>
                        <div class="card-body">
                            <div style="height: 300px;">
                                <canvas id="drawdownChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Calendrier P&L -->
            {% if calendar_data|length > 0 %}
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-calendar3"></i> Calendrier P&L</span>
                        <i class="fas fa-eye clickable" onclick="toggleBlur('calendarPnl')"
                           style="cursor: pointer; font-size: 1.2rem;"></i>
                    </div>
                    <div class="card-body blurrable" id="calendarPnl">
                        <div class="row">
                            {% for month in calendar_data %}
                                <div class="col-lg-6 mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="mb-0">{{ month.label }}</h6>
                                        <span class="fw-bold text-{{ month.total_gain >= 0 ? 'success' : 'danger' }}">
                                            {{ month.total_gain|number_format(2) }} €
                                            <small class="text-muted">({{ month.total_count }} trade{{ month.total_count > 1 ? 's' : '' }})</small>
                                        </span>
                                    </div>
                                    <table class="table table-bordered calendar-table mb-0">
                                        <thead class="table-dark">
                                        <tr>
                                            <th>Lun</th>
                                            <th>Mar</th>
                                            <th>Mer</th>
                                            <th>Jeu</th>
                                            <th>Ven</th>
                                            <th class="calendar-week-total">Semaine</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for week in month.weeks %}
                                            <tr>
                                                {% for cell in week.days %}
                                                    {% if cell is null %}
                                                        <td class="calendar-empty"></td>
                                                    {% elseif cell.data is null %}
                                                        <td>
                                                            <div class="calendar-day-num">{{ cell.day }}</div>
                                                        </td>
                                                    {% else %}
                                                        <td class="bg-{{ cell.data.gain >= 0 ? 'success' : 'danger' }} bg-opacity-25">
                                                            <div class="calendar-day-num">{{ cell.day }}</div>
                                                            <div class="fw-bold text-{{ cell.data.gain >= 0 ? 'success' : 'danger' }}">
                                                                {{ cell.data.gain|number_format(0) }} €
                                                            </div>
                                                            <small class="text-muted">{{ cell.data.count }} trade{{ cell.data.count > 1 ? 's' : '' }}</small>
                                                        </td>
                                                    {% endif %}
                                                {% endfor %}
                                                <td class="calendar-week-total">
                                                    {% if week.count > 0 %}
                                                        <div class="fw-bold text-{{ week.gain >= 0 ? 'success' : 'danger' }}">
                                                            {{ week.gain|number_format(0) }} €
                                                        </div>
                                                        <small class="text-muted">{{ week.rr|number_format(1) }} R</small>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- Tableau des stats détaillées -->
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-table"></i> Statistiques Détaillées
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-dark">
                            <tr>
                                <th>Métrique</th>
                                <th>Valeur</th>
                                <th>Métrique</th>
                                <th>Valeur</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>Nombre total de trades</td>
                                <td class="fw-bold">{{ stats.total_trades }}</td>
                                <td>Gain RR moyen</td>
                                <td class="fw-bold text-{{ stats.avg_gain_rr >= 0 ? 'success' : 'danger' }}">
                                    {{ stats.avg_gain_rr|default(0)|number_format(2) }}
                                </td>
                            </tr>
                            <tr>
                                <td>Trades gagnants</td>
                                <td class="fw-bold text-success">{{ stats.winning_trades }}</td>
                                <td>Gain RR moyen (wins)</td>
                                <td class="fw-bold text-success">
                                    {{ stats.avg_win_rr|default(0)|number_format(2) }}
                                </td>
                            </tr>
                            <tr>
                                <td>Trades perdants</td>
                                <td class="fw-bold text-danger">{{ stats.losing_trades }}</td>
                                <td>Perte RR moyenne (losses)</td>
                                <td class="fw-bold text-danger">
                                    {{ stats.avg_loss_rr|default(0)|number_format(2) }}
                                </td>
                            </tr>
                            <tr>
                                <td>Gain total (€)</td>
                                <td class="fw-bold text-{{ stats.total_gain_euro >= 0 ? 'success' : 'danger' }}">
                                    {{ stats.total_gain_euro|default(0)|number_format(2) }} €
                                </td>
                                <td>Plus gros gain (€)</td>
                                <td class="fw-bold text-success">
                                    {{ stats.max_win_euro|default(0)|number_format(2) }} €
                                </td>
                            </tr>
                            <tr>
                                <td>Gain moyen par trade (€)</td>
                                <td class="fw-bold text-{{ (stats.total_trades > 0 and (stats.total_gain_euro / stats.total_trades) >= 0) ? 'success' : 'danger' }}">
                                    {{ stats.total_trades > 0 ? (stats.total_gain_euro / stats.total_trades)|number_format(2) : 0 }} €
                                </td>
                                <td>Plus grosse perte (€)</td>
                                <td class="fw-bold text-danger">
                                    {{ stats.max_loss_euro|default(0)|number_format(2) }} €
                                </td>
                            </tr>
                            <tr>
                                <td>Max gains consécutifs</td>
                                <td class="fw-bold text-success">{{ stats.max_win_streak }}</td>
                                <td>Max pertes consécutives</td>
                                <td class="fw-bold text-danger">{{ stats.max_loss_streak }}</td>
                            </tr>
                            <tr>
                                <td>Série en cours</td>
                                <td class="fw-bold text-{{ stats.current_streak > 0 ? 'success' : (stats.current_streak < 0 ? 'danger' : 'muted') }}">
                                    {% if stats.current_streak > 0 %}
                                        {{ stats.current_streak }} gain{{ stats.current_streak > 1 ? 's' : '' }}
                                    {% elseif stats.current_streak < 0 %}
                                        {{ -stats.current_streak }} perte{{ stats.current_streak < -1 ? 's' : '' }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td>Profit Factor</td>
                                <td class="fw-bold text-{{ stats.profit_factor is not null and stats.profit_factor < 1 ? 'danger' : 'success' }}">
                                    {{ stats.profit_factor is not null ? stats.profit_factor|number_format(2) : (stats.gross_profit > 0 ? '∞' : '—') }}
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Stats par confluence -->
            {% if confluence_stats|length > 0 %}
                <div class="card">
                    <div class="card-header">
                        <i class="bi bi-lightning-charge"></i> Statistiques par Confluence
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead class="table-dark">
                                <tr>
                                    <th>Confluence</th>
                                    <th>Nombre de trades</th>
                                    <th>Win Rate</th>
                                    <th>Gain moyen (€)</th>
                                    <th>RR moyen</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for confluence, data in confluence_stats %}
                                    <tr>
                                        <td class="fw-bold">{{ confluence }}</td>
                                        <td>{{ data.count }}</td>
                                        <td>
                                    <span class="badge bg-{{ data.win_rate >= 50 ? 'success' : 'danger' }}">
                                        {{ data.win_rate|number_format(1) }}%
                                    </span>
                                        </td>
                                        <td class="text-{{ data.avg_gain >= 0 ? 'success' : 'danger' }} fw-bold">
                                            {{ data.avg_gain|number_format(2) }} €
                                        </td>
                                        <td class="text-{{ data.avg_rr >= 0 ? 'success' : 'danger' }} fw-bold">
                                            {{ data.avg_rr|number_format(2) }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}

            <!-- Section Statistiques par jour -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">Performance par jour de la semaine</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                    <tr>
                                        <th>Jour</th>
                                        <th>Nombre de trades</th>
                                        <th>Taux de réussite</th>
                                        <th>Gain total (€)</th>
                                        <th>Gain moyen (€)</th>
                                        <th>Gain total (R)</th>
                                        <th>Gain moyen (R)</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for day, stats in day_stats %}
                                        <tr>
                                            <td>{{ day|trans }}</td>
                                            <td>{{ stats.total_trades }}</td>
                                            <td>
                                    <span class="badge bg-{{ stats.win_rate >= 50 ? 'success' : 'warning' }}">
                                        {{ stats.win_rate|number_format(1) }}%
                                    </span>
                                            </td>
                                            <td class="{{ stats.total_gain_euro >= 0 ? 'text-success' : 'text-danger' }}">
                                                {{ stats.total_gain_euro|number_format(2) }} €
                                            </td>
                                            <td class="{{ stats.avg_gain_euro >= 0 ? 'text-success' : 'text-danger' }}">
                                                {{ stats.avg_gain_euro|number_format(2) }} €
                                            </td>
                                            <td class="{{ stats.total_gain_rr >= 0 ? 'text-success' : 'text-danger' }}">
                                                {{ stats.total_gain_rr|number_format(2) }} R
                                            </td>
                                            <td class="{{ stats.avg_gain_rr >= 0 ? 'text-success' : 'text-danger' }}">
                                                {{ stats.avg_gain_rr|number_format(2) }} R
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>

        function toggleBlur(elementId) {
            const element = document.getElementById(elementId);
            element.classList.toggle('blurred');
        }

        (function tryInitCharts() {
            if (!document.getElementById('winRateChart')) return;

            if (typeof Chart === 'undefined' || typeof $ === 'undefined') {
                requestAnimationFrame(tryInitCharts);
                return;
            }

            // Détruire les instances Chart.js existantes avant de recréer
            ['winRateChart', 'gainRRChart', 'finalRRChart', 'gainsChart', 'drawdownChart'].forEach(function(id) {
                const existing = Chart.getChart(id);
                if (existing) existing.destroy();
            });

            // Initialisation de Select2 en français
            $('select[name="confluences[]"]').select2({
                theme: 'bootstrap-5',
                placeholder: 'Sélectionnez les confluences',
                allowClear: true,
                width: '100%',
                language: 'fr',
                closeOnSelect: false
            });

            // Win Rate Pie Chart
            const winRateCtx = document.getElementById('winRateChart').getContext('2d');
            new Chart(winRateCtx, {
                type: 'pie',
                data: {
                    labels: ['Gagnants', 'Perdants'],
                    datasets: [{
                        data: [{{ stats.winning_trades }}, {{ stats.losing_trades }}],
                        backgroundColor: ['#28a745', '#dc3545'],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.raw || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });

            // Gains RR Bar Chart
            const gainRRCtx = document.getElementById('gainRRChart').getContext('2d');
            new Chart(gainRRCtx, {
                type: 'bar',
                data: {
                    labels: {{ chart_data.dates|json_encode|raw }},
                    datasets: [{
                        label: 'Gain RR',
                        data: {{ chart_data.gain_rr|json_encode|raw }},
                        backgroundColor: function(context) {
                            const value = context.raw;
                            return value >= 0 ? 'rgba(40, 167, 69, 0.8)' : 'rgba(220, 53, 69, 0.8)';
                        },
                        borderColor: function(context) {
                            const value = context.raw;
                            return value >= 0 ? '#28a745' : '#dc3545';
                        },
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Gain RR'
                            }
                        },
                        x: {
                            display: false
                        }
                    }
                }
            });

            // Final RR Bar Chart
            const finalRRCtx = document.getElementById('finalRRChart').getContext('2d');
            new Chart(finalRRCtx, {
                type: 'bar',
                data: {
                    labels: {{ chart_data.dates|json_encode|raw }},
                    datasets: [{
                        label: 'Final RR',
                        data: {{ chart_data.final_rr|json_encode|raw }},
                        backgroundColor: function(context) {
                            const value = context.raw;
                            return value >= 1 ? 'rgba(40, 167, 69, 0.8)' :
                                value >= 0 ? 'rgba(255, 193, 7, 0.8)' : 'rgba(220, 53, 69, 0.8)';
                        },
                        borderColor: function(context) {
                            const value = context.raw;
                            return value >= 1 ? '#28a745' :
                                value >= 0 ? '#ffc107' : '#dc3545';
                        },
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Final RR'
                            }
                        },
                        x: {
                            display: false
                        }
                    }
                }
            });

            // Drawdown (underwater) Chart
            const drawdownCtx = document.getElementById('drawdownChart').getContext('2d');
            new Chart(drawdownCtx, {
                type: 'line',
                data: {
                    labels: {{ chart_data.dates|json_encode|raw }},
                    datasets: [{
                        label: 'Drawdown (€)',
                        data: {{ chart_data.drawdown|json_encode|raw }},
                        backgroundColor: 'rgba(220, 53, 69, 0.2)',
                        borderColor: '#dc3545',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.1,
                        pointRadius: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            max: 0,
                            title: {
                                display: true,
                                text: 'Drawdown (€)'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Date'
                            }
                        }
                    }
                }
            });

            // Gains Line Chart
            const gainsCtx = document.getElementById('gainsChart').getContext('2d');
            new Chart(gainsCtx, {
                type: 'line',
                data: {
                    labels: {{ chart_data.dates|json_encode|raw }},
                    datasets: [{
                        label: 'Gains cumulés (€)',
                        data: {{ chart_data.cumulative_gains|json_encode|raw }},
                        backgroundColor: 'rgba(52, 152, 219, 0.2)',
                        borderColor: '#3498db',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            title: {
                                display: true,
                                text: 'Gains (€)'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Date'
                            }
                        }
                    }
                }
            });
        })();
    </script>
{% endblock %}
